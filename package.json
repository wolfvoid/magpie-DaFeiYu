{
  "name": "dafeiyu-magpie",
  "version": "0.2.0",
  "private": true,
  "description": "DaFeiYu-magpie — a macOS desktop pet for Magpie with live request lights and multi-account quota badges.",
  "repository": { "type": "git", "url": "https://github.com/wolfvoid/DaFeiYu-magpie.git" },
  "homepage": "https://github.com/wolfvoid/DaFeiYu-magpie#readme",
  "author": "wolfvoid",
  "license": "MIT",
  "keywords": ["magpie", "macos", "desktop-pet", "dafeiyu", "deepseek", "electron", "quota-monitor"],
  "files": ["magpie", "LICENSE", "THIRD_PARTY_NOTICES.md", "licenses"],
  "magpie": {
    "page": {
      "title": "DaFeiYu",
      "titles": { "zh": "蓝色大肥鱼", "zh-TW": "藍色大肥魚" },
      "file": "magpie/index.html",
      "icon": "magpie/icon.png"
    },
    "permissions": []
  },
  "scripts": {
    "build": "esbuild src/vendor/pickers.ts --format=esm --outfile=src/pickers.mjs",
    "start": "electron src/main.cjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "@electron/packager": "20.3.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1"
  }
}

